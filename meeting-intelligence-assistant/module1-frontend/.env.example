# Frontend-specific configuration.
# Copy to .env.local for local development.

# Where the Next.js server proxies /api/* requests (module2 backend).
# Read at build time. In docker compose use http://backend:8000
BACKEND_URL=http://localhost:8000

# Mock switches - let the UI run before the backend endpoints exist.
# Mock data is stored in the browser's localStorage only.
#
# NEXT_PUBLIC_MOCK_AUTH=true      -> login/register are faked in the browser
# NEXT_PUBLIC_MOCK_MEETINGS=true  -> meetings, transcripts, summary, action items,
#                                    decisions and chat are faked in the browser
#
# Mock auth only works together with mock meetings (a fake token is rejected by
# the real backend). Real auth + mock meetings is fine.
# Both default to true when unset.
NEXT_PUBLIC_MOCK_AUTH=false
NEXT_PUBLIC_MOCK_MEETINGS=true
