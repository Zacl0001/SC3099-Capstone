# Frontend-specific configuration.
# Copy to .env.local for local development, then restart `npm run dev`.

# Where the Next.js server proxies /api/* requests (module2 backend).
# Read at build time. In docker compose use http://backend:8000
BACKEND_URL=http://localhost:8000

# Mock switches - stand in for features the backend doesn't provide yet.
# Mock data lives in the browser only (localStorage).
#
# NEXT_PUBLIC_MOCK_AUTH      default false  module2 has register/login/me/logout.
#                                           true = fake accounts; forces the two below on.
# NEXT_PUBLIC_MOCK_MEETINGS  default false  module2 has meeting upload/list and transcript
#                                           process/get. true = fake meetings; forces MOCK_AI on.
# NEXT_PUBLIC_MOCK_AI        default true   module2 has no summary/action-items/decisions/chat
#                                           yet, so they're computed in the browser from the
#                                           real transcript (keyword matching, not an LLM).
NEXT_PUBLIC_MOCK_AUTH=false
NEXT_PUBLIC_MOCK_MEETINGS=false
NEXT_PUBLIC_MOCK_AI=true
