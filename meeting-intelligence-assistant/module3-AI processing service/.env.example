# Copy to .env to override defaults (optional -- values come from
# pydantic-settings in app/core/config.py).

# Ollama's OpenAI-compatible endpoint. Change to an OpenAI/Anthropic
# compatible base URL to swap providers.
LLM_BASE_URL=http://localhost:11434/v1

# Which model to run (must be pulled first: `ollama pull qwen2.5:7b-instruct`).
LLM_MODEL=qwen2.5:7b-instruct

# Seconds to wait for a model response before timing out.
LLM_TIMEOUT_SECONDS=180.0

# Extra attempts on transient failures (network blips, 5xx).
LLM_MAX_RETRIES=2

# 0.0 = deterministic output, good for extraction tasks.
LLM_TEMPERATURE=0.0

# Knowledge Assistant Service (module4) base URL.
KAS_BASE_URL=http://localhost:8002

# Seconds to wait for a KAS response before timing out.
KAS_TIMEOUT_SECONDS=120.0

# Extra attempts on transient KAS failures.
KAS_MAX_RETRIES=2

# Default number of chunks retrieved for /chat.
KAS_SEARCH_TOP_K=5

# Transcripts longer than this many characters are chunked via KAS /chunk
# before LLM analysis (context-window guard).
CHUNK_THRESHOLD_CHARS=20000

LOG_LEVEL=INFO